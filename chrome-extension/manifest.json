{
  "manifest_version": 3,
  "name": "Nexvault",
  "version": "0.1.0",
  "description": "Extension Chrome pour Nexvault – coffre-fort chiffré et autofill local.",
  "permissions": ["storage", "tabs", "activeTab", "scripting", "clipboardWrite"],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "http://localhost:*/*",
    "https://localhost:*/*",
    "http://10.238.110.246:*/*",
    "https://10.238.110.246:*/*"
  ],
  "action": {
    "default_title": "Nexvault",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
